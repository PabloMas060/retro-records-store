<!DOCTYPE html>
<html lang="es">
<%- include('partials/head', { title: 'Nuestras Bandas' }) %>

<body class="products__body">
    <%- include('partials/header') %>

    <header class="products__hero-clean">
        <div class="container">
            <h1 class="products__title">Catálogo de Artistas</h1>
            <p class="products__subtitle">Explorá la historia y el legado discográfico de las mayores leyendas del rock.</p>
        </div>
    </header>

    <main class="container products__main-grid">
        <section class="artists__grid">
            <% bands.forEach(({ id, name, mainImage }) => { %>
                <a href="/products/artists/detail/<%= id %>" class="artist__premium-card">
                    <div class="artist__card-media">
                        <img src="/images/bands/<%= mainImage %>" alt="<%= name %>" class="artist__card-img">
                    </div>
                    <div class="artist__card-content">
                        <h3 class="artist__card-name"><%= name %></h3>
                    </div>
                </a>
            <% }) %>
        </section>
    </main>

    <%- include('partials/footer') %>
</body>
</html>
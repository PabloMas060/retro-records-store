<!DOCTYPE html>
<html lang="es">
<%- include('partials/head', { title: 'Detalle de Producto - ' + merch.name }) %>

    <body class="products__body">
        <%- include('partials/header') %>

            <div class="merch-detail__page-wrapper">
                <main class="merch-detail__container container">

                    <div class="merch-detail__back-nav">
                        <a href="/products/artists/detail/<%= merch.bandId %>" class="back-nav__link">
                            <i class="fa-solid fa-arrow-left"></i> Volver a la banda
                        </a>
                    </div>

                    <div class="merch-detail__main-grid">

                        <section class="merch-detail__media-column">
                            <div class="merch-detail__image-wrapper">
                                <img src="/images/merch/<%= merch.image %>" class="merch-detail__product-img"
                                    alt="<%= merch.name %>">
                            </div>
                        </section>
                        <section class="merch-detail__info-column">
                            <span class="merch-detail__badge">Merchandising Oficial</span>
                            <h1 class="merch-detail__main-title">
                                <%= merch.name %>
                            </h1>

                            <div class="merch-detail__tech-specs">
                                <div class="spec__item">
                                    <span class="spec__label">Disponibilidad:</span>
                                    <span class="spec__value stock-instock">Stock Disponible</span>
                                </div>
                                <div class="spec__item">
                                    <span class="spec__label">Calidad:</span>
                                    <span class="spec__value">Premium Edition</span>
                                </div>
                            </div>

                            <div class="merch-detail__purchase-box">
                                <div class="purchase__price-tag">
                                    <span class="price__currency">USD</span>
                                    <span class="price__amount">$<%= merch.price %></span>
                                </div>
                                <a href="#" class="merch-detail__cart-btn">
                                    <i class="fa-solid fa-bag-shopping"></i> Añadir al carrito
                                </a>
                            </div>

                            <div class="merch-detail__description-box">
                                <h3 class="detail__sub-title">Detalles del artículo</h3>
                                <p class="detail__body-text">
                                    <%= merch.description %>
                                </p>
                            </div>
                        </section>

                    </div>
                </main>
            </div>

            <%- include('partials/footer') %>
    </body>

</html>
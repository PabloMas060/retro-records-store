<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head', { title: 'Iniciar Sesión' }) %>

<body class="auth__body">
    <%- include('../partials/header') %>

    <main class="auth__container">
        <div class="auth__card">
            <h2 class="auth__title">¡Bienvenido de nuevo!</h2>
            <p class="auth__subtitle">Ingresá a tu cuenta en Retro Records Store</p>

            <form action="/users/login" method="POST" class="auth__form">
                <div class="form__group">
                    <label for="email" class="form__label">Email</label>
                    <input type="email" id="email" name="email" class="form__input" placeholder="tu@email.com" required>
                </div>

                <div class="form__group">
                    <label for="password" class="form__label">Contraseña</label>
                    <input type="password" id="password" name="password" class="form__input" placeholder="••••••••" required>
                </div>

                <div class="form__actions">
                    <label class="form__remember">
                        <input type="checkbox" name="remember"> Recordarme
                    </label>
                    <a href="/users/forgot-password" class="form__link">¿Olvidaste tu contraseña?</a>
                </div>

                <button type="submit" class="auth__btn-submit">Iniciar Sesión</button>
            </form>

            <div class="auth__divider">
                <span>o también podés</span>
            </div>

            <a href="/auth/login/google" class="auth__btn-google">
                <img src="https://upload.wikimedia.org/wikipedia/commons/c/c1/Google_%22G%22_logo.svg" alt="Google" class="google__icon">
                Ingresar con Google
            </a>

            <p class="auth__footer-text">
                ¿No estás registrado? <a href="/users/register" class="form__link--highlight">Registrate acá</a>
            </p>
        </div>
    </main>

    <%- include('../partials/footer') %>
</body>
</html>
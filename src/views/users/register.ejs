<!DOCTYPE html>
<html lang="es">
<%- include('../partials/head', { title: 'Registrate' }) %>

  <body class="auth__body">
    <%- include('../partials/header') %>

      <main class="auth__container">
        <div class="auth__card register__card">
          <h2 class="auth__title">Regístrate rápidamente</h2>
          <p class="auth__subtitle">Creá tu cuenta y empezá a armar tu colección</p>

          <form action="/users/register" method="POST" class="auth__form">
            <div class="form__row-grid">
              <div class="form__group">
                <label for="name" class="form__label">Nombres</label>
                <input type="text" id="name" name="name" class="form__input" placeholder="Tu nombre" required>
              </div>
              <div class="form__group">
                <label for="lastName" class="form__label">Apellido</label>
                <input type="text" id="lastName" name="lastName" class="form__input" placeholder="Tu apellido" required>
              </div>
            </div>

            <div class="form__group">
              <label for="email" class="form__label">Email</label>
              <input type="email" id="email" name="email" class="form__input" placeholder="tu@email.com" required>
            </div>

            <div class="form__group">
              <label for="password" class="form__label">Contraseña</label>
              <input type="password" id="password" name="password" class="form__input" placeholder="••••••••" required>
            </div>

            <div class="form__group">
              <label for="confirmPassword" class="form__label">Repita Contraseña</label>
              <input type="password" id="confirmPassword" name="confirmPassword" class="form__input"
                placeholder="••••••••" required>
            </div>

            <button type="submit" class="auth__btn-submit">Registrate</button>
          </form>

          <div class="auth__divider">
            <span>o también podés</span>
          </div>

          <a href="/auth/login/google" class="auth__btn-google">
            <img src="https://upload.wikimedia.org/wikipedia/commons/c/c1/Google_%22G%22_logo.svg" alt="Google"
              class="google__icon">
            Registrarme con Google
          </a>

          <p class="auth__footer-text">
            ¿Ya tenés una cuenta? <a href="/users/login" class="form__link--highlight">Iniciá sesión acá</a>
          </p>
        </div>
      </main>

      <%- include('../partials/footer') %>
  </body>

</html>
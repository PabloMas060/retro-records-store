<!DOCTYPE html>
<html lang="es">
<%- include('partials/head',{ title : 'HOME' }) %>

<body class="home__body">
    <%- include('partials/header') %>

    <header class="home__hero">
        <div class="hero__overlay"></div>
        <img src="/banner-gif01.gif" alt="Retro Records Store" class="hero__img">
        <div class="hero__content">
            <h1 class="hero__title">RETRO RECORDS STORE</h1>
            <p class="hero__subtitle">El templo de los clásicos en vinilo y merchandising oficial.</p>
        </div>
    </header>

    <main class="container">
        
        <section class="shortcut__section">
            <div class="shortcut__grid">
                
               <!--  <a href="/fans" class="shortcut__card">
                    <div class="shortcut__icon-wrapper">
                        <i class="fa-solid fa-users-rays shortcut__icon-modern"></i>
                    </div>
                    <span class="shortcut__label">Para los fans</span>
                    <p class="shortcut__desc">Comunidad, novedades y contenido exclusivo del rock.</p>
                </a> -->

                <a href="/fans" class="shortcut__card">
                    <div class="shortcut__icon-wrapper">
                        <i class="fa-solid fa-compact-disc shortcut__icon-modern"></i>
                    </div>
                    <span class="shortcut__label">Music Player</span>
                    <p class="shortcut__desc">Sintonizá y escuchá muestras de tus discos favoritos.</p>
                </a>

                <a href="/products/artists" class="shortcut__card">
                    <div class="shortcut__icon-wrapper">
                        <i class="fa-solid fa-bolt-lightning shortcut__icon-modern"></i>
                    </div>
                    <span class="shortcut__label">Todos los artistas</span>
                    <p class="shortcut__desc">Explorá el catálogo completo de leyendas y emergentes.</p>
                </a>

            </div>
        </section>

        <section class="music__section">
            <div class="section__header">
                <h2 class="section__title">Iconos del Rock</h2>
                <p class="section__subtitle">Los artistas que marcaron la historia para siempre.</p>
            </div>
            <div class="swiper mySwiper">
                <div class="swiper-wrapper">
                    <% bands.forEach(({id, mainImage, categoryId}) => { %>
                        <% if (categoryId === 1) { %>
                            <div class="swiper-slide">
                                <article class="music__card">
                                    <a href="/products/artists/detail/<%= id %>" class="card__link">
                                        <div class="card__img-wrapper">
                                            <img class="card__img" src="/images/bands/<%= mainImage %>" alt="Artista">
                                        </div>
                                    </a>
                                </article>
                            </div>
                        <% } %>
                    <% }) %>
                </div>
                <div class="swiper-pagination"></div>
            </div>
        </section>

        <section class="music__section">
            <div class="section__header">
                <h2 class="section__title">Clásicos</h2>
                <p class="section__subtitle">Bandas con más de 30 años de pura trayectoria.</p>
            </div>
            <div class="swiper mySwiper">
                <div class="swiper-wrapper">
                    <% bands.forEach(({id, mainImage, categoryId}) => { %>
                        <% if (categoryId === 4) { %>
                            <div class="swiper-slide">
                                <article class="music__card">
                                    <a href="/products/artists/detail/<%= id %>" class="card__link">
                                        <div class="card__img-wrapper">
                                            <img class="card__img" src="/images/bands/<%= mainImage %>" alt="Artista">
                                        </div>
                                    </a>
                                </article>
                            </div>
                        <% } %>
                    <% }) %>
                </div>
                <div class="swiper-pagination"></div>
            </div>
        </section>

        <section class="music__section">
            <div class="section__header">
                <h2 class="section__title">Orgullo Nacional 🇦🇷</h2>
                <p class="section__subtitle">El legado musical que define nuestra identidad.</p>
            </div>
            <div class="swiper mySwiper">
                <div class="swiper-wrapper">
                    <% bands.forEach(({id, mainImage, categoryId}) => { %>
                        <% if (categoryId === 2) { %>
                            <div class="swiper-slide">
                                <article class="music__card">
                                    <a href="/products/artists/detail/<%= id %>" class="card__link">
                                        <div class="card__img-wrapper">
                                            <img class="card__img" src="/images/bands/<%= mainImage %>" alt="Artista">
                                        </div>
                                    </a>
                                </article>
                            </div>
                        <% } %>
                    <% }) %>
                </div>
                <div class="swiper-pagination"></div>
            </div>
        </section>

        <section class="music__section">
            <div class="section__header">
                <h2 class="section__title">Indies que apoyamos</h2>
                <p class="section__subtitle">Descubrí a los nuevos talentos de la escena emergente.</p>
            </div>
            <div class="swiper mySwiper">
                <div class="swiper-wrapper">
                    <% bands.forEach(({id, mainImage, categoryId}) => { %>
                        <% if (categoryId === 3) { %>
                            <div class="swiper-slide">
                                <article class="music__card">
                                    <a href="/products/artists/detail/<%= id %>" class="card__link">
                                        <div class="card__img-wrapper">
                                            <img class="card__img" src="/images/bands/<%= mainImage %>" alt="Artista">
                                        </div>
                                    </a>
                                </article>
                            </div>
                        <% } %>
                    <% }) %>
                </div>
                <div class="swiper-pagination"></div>
            </div>
        </section>

    </main>

    <%- include('partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.js"></script>
    <script>
        var swiper = new Swiper(".mySwiper", {
            slidesPerView: 1.2, // Deja ver un pedacito de la siguiente en móvil
            spaceBetween: 16,
            pagination: {
                el: ".swiper-pagination",
                clickable: true,
            },
            breakpoints: {
                480: { slidesPerView: 2, spaceBetween: 20 },
                768: { slidesPerView: 3, spaceBetween: 24 },
                1024: { slidesPerView: 4.5, spaceBetween: 30 } // Visión amplia en escritorio
            },
        });
    </script>
</body>
</html>
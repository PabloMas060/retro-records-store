<!DOCTYPE html>
<html lang="es">
<%- include('partials/head',{ title : 'HOME' }) %>

    <body class="home__body">

        <%- include('partials/header') %>

        <main class="home">

            <!-- HERO -->
            <section class="hero">
                <div class="hero__bg">
                    <img src="/hero.png" alt="Retro Records Store" class="hero__bg-img">
                    <div class="hero__overlay"></div>
                </div>

                <div class="hero__content">
                    <h1 class="hero__title">
                        RETRO<br>
                        <span class="hero__title--gold">RECORDS</span><br>
                        STORE
                    </h1>

                    <div class="hero__divider"></div>

                    <p class="hero__subtitle">
                        Descubrí bandas legendarias, vinilos exclusivos
                        y merchandising oficial en un solo lugar.
                    </p>

                    <a href="/products/albums" class="hero__button">
                        EXPLORAR TIENDA
                    </a>
                </div>
            </section>

            <!-- ACCESOS RÁPIDOS -->
            <section class="shortcut__section">
                <div class="container">
                    <div class="shortcut__grid">

                        <a href="/products/albums" class="shortcut__card">
                            <div class="shortcut__icon-wrapper">
                                <i class="fa-solid fa-record-vinyl shortcut__icon-modern"></i>
                            </div>
                            <div class="shortcut__text">
                                <span class="shortcut__label">Colección de Vinilos</span>
                                <p class="shortcut__desc">Explorá álbumes legendarios y nuevas ediciones en vinilo.</p>
                            </div>
                            <i class="fa-solid fa-arrow-right shortcut__arrow"></i>
                        </a>

                        <a href="/products/merchs" class="shortcut__card">
                            <div class="shortcut__icon-wrapper">
                                <i class="fa-solid fa-shirt shortcut__icon-modern"></i>
                            </div>
                            <div class="shortcut__text">
                                <span class="shortcut__label">Merchandising Oficial</span>
                                <p class="shortcut__desc">Encontrá remeras, accesorios y artículos exclusivos de tus bandas favoritas.</p>
                            </div>
                            <i class="fa-solid fa-arrow-right shortcut__arrow"></i>
                        </a>

                        <a href="/products/artists" class="shortcut__card">
                            <div class="shortcut__icon-wrapper">
                                <i class="fa-solid fa-guitar shortcut__icon-modern"></i>
                            </div>
                            <div class="shortcut__text">
                                <span class="shortcut__label">Bandas y Artistas</span>
                                <p class="shortcut__desc">Explorá el catálogo completo de bandas y artistas de la tienda.</p>
                            </div>
                            <i class="fa-solid fa-arrow-right shortcut__arrow"></i>
                        </a>

                    </div>
                </div>
            </section>

            <!-- SECCIONES DE BANDAS -->
            <section class="bands__section">
                <div class="container">
                    <div class="bands__category-header">
                        <h2 class="bands__category-title">BANDAS Y ARTISTAS</h2>
                        <div class="bands__category-line"></div>
                        <a href="/products/artists" class="bands__ver-mas">Ver todas <i class="fa-solid fa-arrow-right"></i></a>
                    </div>

                    <div class="bands__grid">
                        <% bands.forEach(({id, image, name}) => { %>
                            <a href="/products/artists/detail/<%= id %>" class="poster__card">
                                <div class="poster__img-wrapper">
                                    <img src="/images/bands/<%= image %>" alt="<%= name %>" class="poster__img">
                                    <div class="poster__overlay"></div>
                                </div>
                                <span class="poster__name"><%= name %></span>
                            </a>
                        <% }) %>
                    </div>
                </div>
            </section>
        </main>

        <%- include('partials/footer') %>

    </body>
</html>

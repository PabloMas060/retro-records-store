<!DOCTYPE html>
<html lang="es">
<%- include('partials/head',{ title : 'Retro Records Store - Home' }) %>

<body class="home__body">
    <%- include('partials/header') %>

    <header class="home__hero">
        <div class="hero__overlay"></div>
        <img src="/banner-gif01.gif" alt="Retro Records Banner" class="hero__img">
        <div class="hero__content">
            <h1 class="hero__title">Retro Records Store</h1>
            <p class="hero__subtitle">El templo de los clásicos en vinilo, CD y merchandising oficial.</p>
        </div>
    </header>

    <nav class="home__shortcuts container">
        <div class="shortcut__grid">
            <div class="shortcut__card">
                <a href="/fans">
                    <img src="/presentacion/presentacion-paraFans.png" alt="Para los fans" class="shortcut__icon">
                    <span class="shortcut__label">Para los fans</span>
                </a>
            </div>
            <div class="shortcut__card">
                <a href="/fans">
                    <img src="/presentacion/presentacion-radio.png" alt="Music Player" class="shortcut__icon">
                    <span class="shortcut__label">Music Player</span>
                </a>
            </div>
            <div class="shortcut__card">
                <a href="/products/artists">
                    <img src="/presentacion/presentacion-artistas.png" alt="Todos los artistas" class="shortcut__icon">
                    <span class="shortcut__label">Todos los artistas</span>
                </a>
            </div>
        </div>
    </nav>

    <main class="home__main container">

        <section class="music__section">
            <div class="section__header">
                <h2 class="section__title">Iconos del Rock</h2>
                <p class="section__subtitle">Artistas indispensables que cambiaron la historia de la música.</p>
            </div>
            
            <div class="swiper mySwiper">
                <div class="swiper-wrapper">
                    <% bands.forEach(({id, mainImage, categoryId}) => { %>
                        <% if (categoryId === 1) { %>
                            <div class="swiper-slide">
                                <article class="music__card">
                                    <a href="/products/artists/detail/<%= id %>" class="card__link">
                                        <div class="card__img-wrapper">
                                            <img class="card__img" src="/images/bands/<%= mainImage %>" alt="Band Image">
                                        </div>
                                    </a>
                                </article>
                            </div>
                        <% } %>
                    <% }) %>
                </div>
                <div class="swiper-pagination"></div>
            </div>
        </section>

        <section class="music__section">
            <div class="section__header">
                <h2 class="section__title">Clásicos</h2>
                <p class="section__subtitle">Bandas legendarias con más de 30 años de pura trayectoria.</p>
            </div>
            
            <div class="swiper mySwiper">
                <div class="swiper-wrapper">
                    <% bands.forEach(({id, mainImage, categoryId}) => { %>
                        <% if (categoryId === 4) { %>
                            <div class="swiper-slide">
                                <article class="music__card">
                                    <a href="/products/artists/detail/<%= id %>" class="card__link">
                                        <div class="card__img-wrapper">
                                            <img class="card__img" src="/images/bands/<%= mainImage %>" alt="Band Image">
                                        </div>
                                    </a>
                                </article>
                            </div>
                        <% } %>
                    <% }) %>
                </div>
                <div class="swiper-pagination"></div>
            </div>
        </section>

        <section class="music__section">
            <div class="section__header">
                <h2 class="section__title">Orgullo Nacional 🇦🇷</h2>
                <p class="section__subtitle">Celebramos el increíble y eterno legado musical de nuestro país.</p>
            </div>
            
            <div class="swiper mySwiper">
                <div class="swiper-wrapper">
                    <% bands.forEach(({id, mainImage, categoryId}) => { %>
                        <% if (categoryId === 2) { %>
                            <div class="swiper-slide">
                                <article class="music__card">
                                    <a href="/products/artists/detail/<%= id %>" class="card__link">
                                        <div class="card__img-wrapper">
                                            <img class="card__img" src="/images/bands/<%= mainImage %>" alt="Band Image">
                                        </div>
                                    </a>
                                </article>
                            </div>
                        <% } %>
                    <% }) %>
                </div>
                <div class="swiper-pagination"></div>
            </div>
        </section>

        <section class="music__section">
            <div class="section__header">
                <h2 class="section__title">Indies que apoyamos</h2>
                <p class="section__subtitle">Proyectos emergentes listos para romper tus auriculares.</p>
            </div>
            
            <div class="swiper mySwiper">
                <div class="swiper-wrapper">
                    <% bands.forEach(({id, mainImage, categoryId}) => { %>
                        <% if (categoryId === 3) { %>
                            <div class="swiper-slide">
                                <article class="music__card">
                                    <a href="/products/artists/detail/<%= id %>" class="card__link">
                                        <div class="card__img-wrapper">
                                            <img class="card__img" src="/images/bands/<%= mainImage %>" alt="Band Image">
                                        </div>
                                    </a>
                                </article>
                            </div>
                        <% } %>
                    <% }) %>
                </div>
                <div class="swiper-pagination"></div>
            </div>
        </section>

    </main>

    <%- include('partials/footer') %>

    <script src="https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.js"></script>
    <script>
        var swiper = new Swiper(".mySwiper", {
            slidesPerView: 1,
            spaceBetween: 16,
            pagination: {
                el: ".swiper-pagination",
                clickable: true,
            },
            breakpoints: {
                480: { slidesPerView: 2, spaceBetween: 20 },
                768: { slidesPerView: 3, spaceBetween: 24 },
                1024: { slidesPerView: 4, spaceBetween: 24 } // Agregamos soporte para pantallas grandes de escritorio
            },
        });
    </script>
</body>
</html>
<!DOCTYPE html>
<html lang="es">
<%- include('partials/head', { title: 'Detalle de Álbum - ' + album.title }) %>

<body class="products__body">
    <%- include('partials/header') %>

    <div class="album-detail__page-wrapper">
        <main class="album-detail__container container">
            
            <div class="album-detail__back-nav">
                <a href="/products/artists/detail/<%= album.bandId %>" class="back-nav__link">
                    <i class="fa-solid fa-arrow-left"></i> Volver a la banda
                </a>
            </div>

            <div class="album-detail__main-grid">
                
                <section class="album-detail__media-column">
                    <div class="album-detail__cover-wrapper">
                        <img src="/images/albums/<%= album.image %>" class="album-detail__cover-img" alt="<%= album.title %>">
                    </div>
                </section>

                <section class="album-detail__info-column">
                    <span class="album-detail__meta-year"><%= album.year %> • Vinilo Oficial</span>
                    <h1 class="album-detail__main-title"><%= album.title %></h1>
                    
                    <div class="album-detail__tech-specs">
                        <div class="spec__item">
                            <span class="spec__label">Género:</span>
                            <span class="spec__value">
                                <% genres.forEach(genre => { %>
                                    <% if (genre.id === album.genreId) { %>
                                        <%= genre.name %>
                                    <% } %>
                                <% }) %>
                            </span>
                        </div>
                        <div class="spec__item">
                            <span class="spec__label">Formato:</span>
                            <span class="spec__value">LP de Vinilo (180g)</span>
                        </div>
                    </div>

                    <div class="album-detail__purchase-box">
                        <div class="purchase__price-tag">
                            <span class="price__currency">USD</span>
                            <span class="price__amount">$<%= album.price %></span>
                        </div>
                        
                        <form action="/api/cart/addProduct" method="POST">
                            <input type="hidden" name="albumId" value="<%= album.id %>">
                            <button type="submit" class="album-detail__cart-btn">
                                <i class="fa-solid fa-bag-shopping"></i> Agregar al Carrito
                            </button>
                        </form>
                    </div>

                    <div class="album-detail__description-box">
                        <h3 class="detail__sub-title">Reseña del Álbum</h3>
                        <p class="detail__body-text"><%= album.description %></p>
                    </div>
                </section>

            </div>

            <footer class="album-detail__tracks-section">
                <h3 class="detail__sub-title text-center"><i class="fa-solid fa-list-ol"></i> Lista de Canciones</h3>
                <div class="album-detail__tracklist-wrapper">
                    <ol class="album-detail__tracklist">
                        <% tracks.forEach(({ id, name }, index) => { %>
                            <li class="tracklist__item">
                                <span class="track__number"><%= String(index + 1).padStart(2, '0') %></span>
                                <span class="track__name"><%= name %></span>
                                <span class="track__duration-placeholder"><i class="fa-solid fa-music"></i></span>
                            </li>
                        <% }) %>
                    </ol>
                </div>
            </footer>

        </main>
    </div>

    <%- include('partials/footer') %>


    </body>
    <script>
    // Esto mostrará en la consola si tus variables tienen contenido
    console.log("DEBUG FLASH:", {
        success: '<%= typeof successMessage !== "undefined" ? successMessage : "NO DEFINIDO" %>',
        error: '<%= typeof errorMessage !== "undefined" ? errorMessage : "NO DEFINIDO" %>'
    });
</script>
</html>
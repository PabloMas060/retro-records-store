<header class="site__header">
    <div class="header__container-fluid">
        <a href="/" class="header__logo-text">
            RETRO <span class="logo__highlight">RECORDS</span> STORE
        </a>

        <nav class="header__nav">
            <ul class="nav__list">
                
                <li>
                    <a href="/products/artists" class="nav__link">
                        <i class="fa-solid fa-guitar nav__icon-fa"></i>
                        <span class="nav__text">Bandas</span>
                    </a>
                </li>

                <% if (locals.user) { %>
                    <li>
                        <a href="/api/cart" class="nav__link nav__cart-link">
                            <i class="fa-solid fa-bag-shopping nav__icon-fa"></i>
                            <span class="nav__text">Carrito</span>
                        </a>
                    </li>
                    
                    <li>
                        <a href="/users/profile" class="nav__link profile-highlight">
                            <i class="fa-solid fa-circle-user nav__icon-fa" style="color: #c5a059;"></i>
                            <span class="nav__text">Hola, <%= user.name || user.first_name || 'Perfil' %></span>
                        </a>
                    </li>

                    <% if (user.rolId === 1) { %>
                        <li>
                            <a href="/users/admin" class="nav__link" style="color: #c5a059;">
                                <i class="fa-solid fa-screwdriver-wrench nav__icon-fa"></i>
                                <span class="nav__text">Admin</span>
                            </a>
                        </li>
                    <% } %>

                    <li>
                        <a href="/users/logout" class="nav__link">
                            <i class="fa-solid fa-right-from-bracket nav__icon-fa"></i>
                            <span class="nav__text">Salir</span>
                        </a>
                    </li>

                <% } else { %>
                    <li>
                        <a href="/users/login" class="nav__link">
                            <i class="fa-solid fa-user nav__icon-fa"></i>
                            <span class="nav__text">Ingresar</span>
                        </a>
                    </li>
                <% } %>
            </ul>
        </nav>
    </div>
</header>

<div class="container mt-3">
    <% if (locals.successMessage && successMessage.length > 0) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <%= successMessage %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <% if (locals.errorMessage && errorMessage.length > 0) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <%= errorMessage %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>
</div>

<script>
    const btnMenuLeft = document.getElementById('btn-menu-left');
    const menuLeft = document.getElementById('menu-left');
    const btnCloseMenuLeft = document.getElementById('close-menu-left');

    if (btnMenuLeft && menuLeft) {
        btnMenuLeft.addEventListener('click', () => {
            menuLeft.classList.toggle('menu-left-visible');
        });
    }

    if (btnCloseMenuLeft && menuLeft) {
        btnCloseMenuLeft.addEventListener('click', () => {
            menuLeft.classList.remove('menu-left-visible');
        });
    }
</script>
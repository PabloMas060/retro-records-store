<!DOCTYPE html>
<html>

<%- include('../partials/head',{ title : 'ADMIN' }) %>

    <body>
        <%- include('../partials/header') %>

            <main class="add-form__page-wrapper">

    <div class="add-form__container">

        <!-- BACK -->

        <nav class="add-form__back-nav">
            <a href="/users/admin" class="back-nav__link">
                <i class="fa-solid fa-arrow-left"></i>
                Volver al panel de administración
            </a>
        </nav>

        <!-- HEADER -->

        <div class="add-form__header">

            <div class="add-form__header-icon">
                <i class="fa-solid fa-shirt"></i>
            </div>

            <div class="add-form__header-content">

                <span class="add-form__eyebrow">
                    ADMINISTRACIÓN
                </span>

                <h1 class="add-form__title">
                    Nuevo Producto
                </h1>

                <p class="add-form__subtitle">
                    Sumá merchandising oficial al catálogo de Retro Records Store.
                </p>

            </div>

        </div>

        <!-- FORM -->

        <form
            class="add-form__card"
            id="merchForm"
            action="/products/mercheAdd"
            method="POST"
            enctype="multipart/form-data">

            <!-- IDENTIDAD -->

            <section class="add-form__section">

                <h2 class="add-form__section-title">
                    <span class="add-form__section-num">01</span>
                    Identidad
                </h2>

                <div class="add-form__grid">

                    <div class="add-form__field add-form__field--wide">

                        <label class="add-form__label" for="name">
                            Nombre del producto
                        </label>

                        <input
                            type="text"
                            id="name"
                            name="name"
                            class="add-form__input <%= locals.errors && (errors.name && 'is-invalid') %>"
                            value="<%= locals.old && (old.name && old.name) %>">

                        <small class="add-form__error">
                            <%= locals.errors && (errors.name && errors.name.msg) %>
                        </small>

                    </div>

                    <div class="add-form__field">

                        <label class="add-form__label" for="bandId">
                            Banda
                        </label>

                        <select
                            id="bandId"
                            name="bandId"
                            class="add-form__input add-form__select <%= locals.errors && (errors.bandId && 'is-invalid') %>">

                            <option selected hidden value="">
                                Seleccione...
                            </option>

                            <% bands.forEach(band=> { %>
                                <option value="<%= band.id %>">
                                    <%= band.name %>
                                </option>
                            <% }) %>

                        </select>

                        <small class="add-form__error">
                            <%= locals.errors && (errors.bandId && errors.bandId.msg) %>
                        </small>

                    </div>

                    <div class="add-form__field">

                        <label class="add-form__label" for="typeId">
                            Tipo
                        </label>

                        <select
                            id="typeId"
                            name="typeId"
                            class="add-form__input add-form__select <%= locals.errors && (errors.typeId && 'is-invalid') %>">

                            <option selected hidden value="">
                                Seleccione...
                            </option>

                            <% types.forEach(type=> { %>
                                <option value="<%= type.id %>">
                                    <%= type.name %>
                                </option>
                            <% }) %>

                        </select>

                        <small class="add-form__error">
                            <%= locals.errors && (errors.typeId && errors.typeId.msg) %>
                        </small>

                    </div>

                </div>

            </section>

            <!-- VENTA -->

            <section class="add-form__section">

                <h2 class="add-form__section-title">
                    <span class="add-form__section-num">02</span>
                    Venta
                </h2>

                <div class="add-form__grid">

                    <div class="add-form__field">

                        <label class="add-form__label" for="price">
                            Precio
                        </label>

                        <input
                            type="number"
                            step="0.01"
                            id="price"
                            name="price"
                            class="add-form__input <%= locals.errors && (errors.price && 'is-invalid') %>"
                            value="<%= locals.old && (old.price && old.price) %>">

                        <small class="add-form__error">
                            <%= locals.errors && (errors.price && errors.price.msg) %>
                        </small>

                    </div>

                    <div class="add-form__field">

                        <label class="add-form__label" for="discount">
                            Descuento (%)
                        </label>

                        <input
                            type="number"
                            step="0.01"
                            id="discount"
                            name="discount"
                            class="add-form__input <%= locals.errors && (errors.discount && 'is-invalid') %>"
                            value="<%= locals.old && (old.discount && old.discount) %>">

                        <small class="add-form__error">
                            <%= locals.errors && (errors.discount && errors.discount.msg) %>
                        </small>

                    </div>

                </div>

            </section>

            <!-- DESCRIPCIÓN -->

            <section class="add-form__section">

                <h2 class="add-form__section-title">
                    <span class="add-form__section-num">03</span>
                    Descripción
                </h2>

                <div class="add-form__grid">

                    <div class="add-form__field add-form__field--wide">

                        <label class="add-form__label" for="description">
                            Descripción
                        </label>

                        <textarea
                            id="description"
                            name="description"
                            class="add-form__input add-form__textarea <%= locals.errors && (errors.description && 'is-invalid') %>"><%= locals.old && (old.description && old.description) %></textarea>

                        <small class="add-form__error">
                            <%= locals.errors && (errors.description && errors.description.msg) %>
                        </small>

                    </div>

                    <div class="add-form__field add-form__field--checkbox-row add-form__field--wide">

                        <label class="add-form__checkbox-label">

                            <input
                                type="checkbox"
                                id="exclusive"
                                name="exclusive"
                                class="add-form__checkbox">

                            <span class="add-form__checkbox-text">
                                Producto exclusivo
                            </span>

                        </label>

                    </div>

                </div>

            </section>

            <!-- IMAGEN -->

            <section class="add-form__section">

                <h2 class="add-form__section-title">
                    <span class="add-form__section-num">04</span>
                    Imagen
                </h2>

                <div class="add-form__field">

                    <label for="image" class="add-form__file-btn">
                        <i class="fa-solid fa-image"></i>
                        Seleccionar imagen del producto
                    </label>

                    <input
                        hidden
                        type="file"
                        id="image"
                        name="image"
                        class="<%= locals.errors && (errors.image && 'is-invalid') %>">

                    <small class="add-form__error">
                        <%= locals.errors && (errors.image && errors.image.msg) %>
                    </small>

                </div>

            </section>

            <!-- ACCIONES -->

            <div class="add-form__actions">

                <a href="/users/admin" class="add-form__btn-cancel">
                    Cancelar
                </a>

                <button
                    type="submit"
                    class="add-form__btn-submit"
                    id="enviarForm">

                    <i class="fa-solid fa-plus"></i>
                    Agregar producto

                </button>

            </div>

        </form>

    </div>

</main>




            <%- include('../partials/footer') %>

                <script src="/javascripts/addMerchFrontendValidations.js"></script>

    </body>



</html>
<!DOCTYPE html>
<html>

<%- include('../partials/head',{ title : 'ADMIN' }) %>

    <body>
        <%- include('../partials/header') %>

            <main class="add-form__page-wrapper">

    <div class="add-form__container">

        <!-- BACK -->

        <nav class="add-form__back-nav">
            <a href="/users/admin" class="back-nav__link">
                <i class="fa-solid fa-arrow-left"></i>
                Volver al panel de administración
            </a>
        </nav>

        <!-- HEADER -->

        <div class="add-form__header">

            <div class="add-form__header-icon">
                <i class="fa-solid fa-pen"></i>
            </div>

            <div class="add-form__header-content">

                <span class="add-form__eyebrow">
                    ADMINISTRACIÓN
                </span>

                <h1 class="add-form__title">
                    Editar Banda
                </h1>

                <p class="add-form__subtitle">
                    Estás editando:
                    <strong><%= band.name %></strong>
                </p>

            </div>

        </div>

        <form
            id="editBandForm"
            class="add-form__card"
            action="/products/edit/band/<%= band.id %>?_method=PUT"
            method="POST"
            enctype="multipart/form-data">

            <!-- IDENTIDAD -->

            <section class="add-form__section">

                <h2 class="add-form__section-title">
                    <span class="add-form__section-num">01</span>
                    Identidad
                </h2>

                <div class="add-form__grid">

                    <div class="add-form__field add-form__field--wide">
                        <label class="add-form__label" for="name">
                            Nombre de la Banda
                        </label>

                        <input
                            type="text"
                            id="name"
                            name="name"
                            class="add-form__input <%= locals.errors && (errors.name && 'is-invalid') %>"
                            value="<%= band.name %>">

                        <small class="add-form__error">
                            <%= locals.errors && (errors.name && errors.name.msg) %>
                        </small>
                    </div>

                    <div class="add-form__field">
                        <label class="add-form__label" for="categoryId">
                            Categoría
                        </label>

                        <select
                            id="categoryId"
                            name="categoryId"
                            class="add-form__input add-form__select">

                            <% categories.forEach(category=> { %>

                                <option
                                    <%= category.id===band.categoryId ? 'selected' : '' %>
                                    value="<%= category.id %>">

                                    <%= category.name %>

                                </option>

                            <% }) %>

                        </select>
                    </div>

                    <div class="add-form__field">
                        <label class="add-form__label" for="phrase">
                            Frase
                        </label>

                        <input
                            type="text"
                            id="phrase"
                            name="phrase"
                            class="add-form__input <%= locals.errors && (errors.phrase && 'is-invalid') %>"
                            value="<%= band.phrase %>">

                        <small class="add-form__error">
                            <%= locals.errors && (errors.phrase && errors.phrase.msg) %>
                        </small>
                    </div>

                </div>

            </section>

            <!-- HISTORIA -->

            <section class="add-form__section">

                <h2 class="add-form__section-title">
                    <span class="add-form__section-num">02</span>
                    Historia
                </h2>

                <div class="add-form__grid">

                    <div class="add-form__field">
                        <label class="add-form__label" for="history">
                            Historia
                        </label>

                        <textarea
                            id="history"
                            name="history"
                            class="add-form__input add-form__textarea <%= locals.errors && (errors.history && 'is-invalid') %>"><%= band.history %></textarea>

                        <small class="add-form__error">
                            <%= locals.errors && (errors.history && errors.history.msg) %>
                        </small>
                    </div>

                    <div class="add-form__field">
                        <label class="add-form__label" for="resume">
                            Resumen
                        </label>

                        <textarea
                            id="resume"
                            name="resume"
                            class="add-form__input add-form__textarea <%= locals.errors && (errors.resume && 'is-invalid') %>"><%= band.resume %></textarea>

                        <small class="add-form__error">
                            <%= locals.errors && (errors.resume && errors.resume.msg) %>
                        </small>
                    </div>

                </div>

            </section>

            <!-- ACTIVIDAD -->

            <section class="add-form__section">

                <h2 class="add-form__section-title">
                    <span class="add-form__section-num">03</span>
                    Actividad
                </h2>

                <div class="add-form__grid">

                    <div class="add-form__field">
                        <label class="add-form__label" for="dateFounded">
                            Año de fundación
                        </label>

                        <input
                            type="number"
                            id="dateFounded"
                            name="dateFounded"
                            class="add-form__input <%= locals.errors && (errors.dateFounded && 'is-invalid') %>"
                            value="<%= band.dateFounded %>">

                        <small class="add-form__error">
                            <%= locals.errors && (errors.dateFounded && errors.dateFounded.msg) %>
                        </small>
                    </div>

                    <div class="add-form__field">
                        <label class="add-form__label" for="dateEnded">
                            Año de finalización
                        </label>

                        <input
                            type="number"
                            id="dateEnded"
                            name="dateEnded"
                            class="add-form__input"
                            value="<%= band.dateEnded ? band.dateEnded : 0 %>">
                    </div>

                    <div class="add-form__field">
                        <label class="add-form__label" for="totalShows">
                            Total de conciertos
                        </label>

                        <input
                            type="number"
                            id="totalShows"
                            name="totalShows"
                            class="add-form__input <%= locals.errors && (errors.totalShows && 'is-invalid') %>"
                            value="<%= band.totalShows %>">

                        <small class="add-form__error">
                            <%= locals.errors && (errors.totalShows && errors.totalShows.msg) %>
                        </small>
                    </div>

                    <div class="add-form__field">
                        <label class="add-form__label" for="nextShows">
                            Próximo concierto
                        </label>

                        <input
                            type="date"
                            id="nextShows"
                            name="nextShows"
                            class="add-form__input <%= locals.errors && (errors.nextShows && 'is-invalid') %>"
                            value="<%= band.nextShows %>">

                        <small class="add-form__error">
                            <%= locals.errors && (errors.nextShows && errors.nextShows.msg) %>
                        </small>
                    </div>

                    <div class="add-form__field add-form__field--checkbox-row add-form__field--wide">

                        <label class="add-form__checkbox-label">

                            <input
                                type="checkbox"
                                id="vigente"
                                name="vigente"
                                class="add-form__checkbox"
                                <% if (!band.dateEnded) { %>checked<% } %>
                                onclick="toggleFechaFinalizacion()">

                            <span class="add-form__checkbox-text">
                                Banda vigente
                            </span>

                        </label>

                    </div>

                </div>

            </section>

            <!-- IMÁGENES -->

            <section class="add-form__section">

                <h2 class="add-form__section-title">
                    <span class="add-form__section-num">04</span>
                    Imágenes
                </h2>

                <div class="add-form__grid">

                    <div class="add-form__field">

                        <label class="add-form__label">
                            Imagen actual
                        </label>

                        <img
                            src="/images/bands/<%= band.mainImage %>"
                            alt="<%= band.name %>"
                            class="admin-preview-image">

                        <label for="mainImage" class="add-form__file-btn">
                            <i class="fa-solid fa-image"></i>
                            Cambiar imagen principal
                        </label>

                        <input
                            hidden
                            type="file"
                            id="mainImage"
                            name="mainImage">

                    </div>

                    <div class="add-form__field">

                        <label class="add-form__label">
                            Logo actual
                        </label>

                        <img
                            src="/images/bands/<%= band.image %>"
                            alt="<%= band.name %>"
                            class="admin-preview-image">

                        <label for="image" class="add-form__file-btn">
                            <i class="fa-solid fa-image"></i>
                            Cambiar logo
                        </label>

                        <input
                            hidden
                            type="file"
                            id="image"
                            name="image">

                    </div>

                </div>

            </section>

            <!-- ACCIONES -->

            <div class="add-form__actions">

                <a href="/users/admin" class="add-form__btn-cancel">
                    Cancelar
                </a>

                <button
                    type="submit"
                    class="add-form__btn-submit">

                    <i class="fa-solid fa-floppy-disk"></i>
                    Actualizar banda

                </button>

            </div>

            <small id="msgError-empty" class="add-form__error"></small>

        </form>

    </div>

</main>

            <script>
                function toggleFechaFinalizacion() {
                    const fechaFinalizacion = document.getElementById("fechaFinalizacion");
                    const vigenteCheckbox = document.getElementById("vigente");

                    if (vigenteCheckbox.checked) {
                        fechaFinalizacion.disabled = true;
                    } else {
                        fechaFinalizacion.disabled = false;
                    }
                }
            </script>
            <script src="/javascripts/editBandFrontendValidations.js"></script>


            <%- include('../partials/footer') %>

    </body>

</html>
                                        <div class="admin__pagination" data-pagination-for="merch">
                                            <button type="button" class="admin__page-btn" data-page-action="prev"
                                                aria-label="Página anterior">
                                                <i class="fa-solid fa-chevron-left"></i>
                                            </button>
                                            <span class="admin__page-info">Página <span data-page-current>1</span> de
                                                <span data-page-total>1</span></span>
                                            <button type="button" class="admin__page-btn" data-page-action="next"

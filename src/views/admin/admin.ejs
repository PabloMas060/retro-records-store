<%- include('../partials/head',{ title : 'Panel de Administración' }) %>

    <body class="admin__body">
        <%- include('../partials/head',{ title : 'Panel de Administración' }) %>

            <body class="admin__body">
                <%- include('../partials/header') %>

                    <% const categoryLabels={ 1: 'Ícono del rock' , 2: 'Orgullo nacional' , 3: 'Indie' , 4: 'Clásico' };
                        const genreLabels={ 1: 'Rock' , 2: 'Pop' , 3: 'Indie' , 4: 'Metal' }; const typeLabels={
                        1: 'Remera' , 2: 'Campera' , 3: 'Poster' , 4: 'Taza' , 5: 'Mochila' , 6: 'Sticker' , 7: 'Hoodie'
                        , 8: 'Emblema' , 9: 'Púa' , 10: 'Merchandising General' , 11: 'Indumentaria General' ,
                        12: 'Cápsula del tiempo' }; const totalShows=bands.reduce((acc, b)=> acc + (b.totalShows || 0),
                        0);
                        %>

                        <div class="admin__page-wrapper">
                            <div class="admin__layout">

                                <!-- ============== SIDEBAR ============== -->
                                <aside class="admin__sidebar">
                                    <span class="admin__sidebar-label">Panel admin</span>

                                    <nav class="admin__nav">
                                        <button type="button" class="admin__nav-link is-active" data-panel="resumen">
                                            <i class="fa-solid fa-gauge-high"></i>
                                            <span>Resumen</span>
                                        </button>
                                        <button type="button" class="admin__nav-link" data-panel="bandas">
                                            <i class="fa-solid fa-guitar"></i>
                                            <span>Bandas</span>
                                            <span class="admin__nav-count">
                                                <%= bands.length %>
                                            </span>
                                        </button>
                                        <button type="button" class="admin__nav-link" data-panel="albumes">
                                            <i class="fa-solid fa-compact-disc"></i>
                                            <span>Álbumes</span>
                                            <span class="admin__nav-count">
                                                <%= albums.length %>
                                            </span>
                                        </button>
                                        <button type="button" class="admin__nav-link" data-panel="merch">
                                            <i class="fa-solid fa-shirt"></i>
                                            <span>Merchandising</span>
                                            <span class="admin__nav-count">
                                                <%= merchs.length %>
                                            </span>
                                        </button>
                                    </nav>

                                    <a href="/" class="admin__sidebar-back">
                                        <i class="fa-solid fa-arrow-left"></i>
                                        <span>Volver al sitio</span>
                                    </a>
                                </aside>

                                <!-- ============== CONTENIDO ============== -->
                                <main class="admin__content">

                                    <!-- ========== PANEL: RESUMEN ========== -->
                                    <section class="admin__panel is-active" id="panel-resumen">
                                        <div class="admin__panel-header">
                                            <div>
                                                <h1 class="admin__title">Panel de Administración</h1>
                                                <p class="admin__subtitle">Gestioná bandas, álbumes y merchandising de
                                                    la tienda.</p>
                                            </div>
                                        </div>

                                        <div class="admin__stats-grid">
                                            <div class="admin__stat-card">
                                                <div class="admin__stat-icon"><i class="fa-solid fa-guitar"></i></div>
                                                <div class="admin__stat-text">
                                                    <span class="admin__stat-value">
                                                        <%= bands.length %>
                                                    </span>
                                                    <span class="admin__stat-label">Bandas</span>
                                                </div>
                                            </div>
                                            <div class="admin__stat-card">
                                                <div class="admin__stat-icon"><i class="fa-solid fa-compact-disc"></i>
                                                </div>
                                                <div class="admin__stat-text">
                                                    <span class="admin__stat-value">
                                                        <%= albums.length %>
                                                    </span>
                                                    <span class="admin__stat-label">Álbumes</span>
                                                </div>
                                            </div>
                                            <div class="admin__stat-card">
                                                <div class="admin__stat-icon"><i class="fa-solid fa-shirt"></i></div>
                                                <div class="admin__stat-text">
                                                    <span class="admin__stat-value">
                                                        <%= merchs.length %>
                                                    </span>
                                                    <span class="admin__stat-label">Productos de merch</span>
                                                </div>
                                            </div>
                                            <div class="admin__stat-card">
                                                <div class="admin__stat-icon"><i class="fa-solid fa-music"></i></div>
                                                <div class="admin__stat-text">
                                                    <span class="admin__stat-value">
                                                        <%= totalShows %>
                                                    </span>
                                                    <span class="admin__stat-label">Shows totales</span>
                                                </div>
                                            </div>
                                        </div>

                                        <h2 class="admin__section-title">Accesos rápidos</h2>
                                        <div class="shortcut__grid admin__shortcuts">
                                            <a href="/products/addBand" class="shortcut__card">
                                                <div class="shortcut__icon-wrapper"><i
                                                        class="fa-solid fa-plus shortcut__icon-modern"></i></div>
                                                <span class="shortcut__label">Agregar banda</span>
                                                <p class="shortcut__desc">Sumá un nuevo artista al catálogo.</p>
                                            </a>
                                            <a href="/products/albumAdd" class="shortcut__card">
                                                <div class="shortcut__icon-wrapper"><i
                                                        class="fa-solid fa-plus shortcut__icon-modern"></i></div>
                                                <span class="shortcut__label">Agregar álbum</span>
                                                <p class="shortcut__desc">Cargá un nuevo lanzamiento o reedición.</p>
                                            </a>
                                            <a href="/products/mercheAdd" class="shortcut__card">
                                                <div class="shortcut__icon-wrapper"><i
                                                        class="fa-solid fa-plus shortcut__icon-modern"></i></div>
                                                <span class="shortcut__label">Agregar merch</span>
                                                <p class="shortcut__desc">Sumá indumentaria o accesorios nuevos.</p>
                                            </a>
                                        </div>
                                    </section>

                                    <!-- ========== PANEL: BANDAS ========== -->
                                    <section class="admin__panel" id="panel-bandas">
                                        <div class="admin__panel-header">
                                            <div>
                                                <h1 class="admin__title">Bandas</h1>
                                                <p class="admin__subtitle">
                                                    <%= bands.length %> artistas en el catálogo.
                                                </p>
                                            </div>
                                            <a href="/products/addBand" class="admin__btn-add">
                                                <i class="fa-solid fa-plus"></i> Agregar banda
                                            </a>
                                        </div>

                                        <div class="admin__table-toolbar">
                                            <div class="admin__search-box">
                                                <i class="fa-solid fa-magnifying-glass"></i>
                                                <input type="text" class="admin__search-input" data-search-for="bandas"
                                                    placeholder="Buscar banda...">
                                            </div>
                                            <span class="admin__search-count" data-search-count-for="bandas">
                                                <%= bands.length %> resultados
                                            </span>
                                        </div>

                                        <div class="admin__table-wrapper" data-table="bandas">
                                            <table class="admin__table">
                                                <thead>
                                                    <tr>
                                                        <th>Banda</th>
                                                        <th>Categoría</th>
                                                        <th>Shows</th>
                                                        <th class="admin__col-actions">Acciones</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% bands.forEach(({ id, name, mainImage, totalShows, resume,
                                                        categoryId })=> { %>
                                                        <tr data-search-key="<%= name.toLowerCase() %>">
                                                            <td>
                                                                <div class="admin__row-media">
                                                                    <div class="admin__row-thumb"><img
                                                                            src="/images/bands/<%= mainImage %>"
                                                                            alt="<%= name %>"></div>
                                                                    <span class="admin__row-name">
                                                                        <%= name %>
                                                                    </span>
                                                                </div>
                                                            </td>
                                                            <td><span class="admin__badge">
                                                                    <%= categoryLabels[categoryId] || categoryId %>
                                                                </span></td>
                                                            <td class="admin__col-number">
                                                                <%= totalShows %>
                                                            </td>
                                                            <td>
                                                                <div class="admin__actions">
                                                                    <button type="button"
                                                                        class="admin__icon-btn admin__icon-btn--view"
                                                                        data-bs-toggle="modal"
                                                                        data-bs-target="#viewBand<%= id %>" title="Ver">
                                                                        <i class="fa-solid fa-eye"></i>
                                                                    </button>
                                                                    <button
                                                                        class="admin__icon-btn admin__icon-btn--edit"
                                                                        title="Editar">
                                                                        <a href="/products/edit/band/<%= id %>"
                                                                            class="admin__icon-btn admin__icon-btn--edit"
                                                                            title="Editar">
                                                                            <i class="fa-solid fa-pen"></i>
                                                                        </a>
                                                                    </button>

                                                                    <button type="button"
                                                                        class="admin__icon-btn admin__icon-btn--delete"
                                                                        data-bs-toggle="modal"
                                                                        data-bs-target="#deleteBand<%= id %>"
                                                                        title="Eliminar">
                                                                        <i class="fa-solid fa-trash"></i>
                                                                    </button>
                                                                </div>
                                                            </td>
                                                        </tr>

                                                        <!-- Modal: ver banda -->
                                                        <div class="modal fade admin__modal" id="viewBand<%= id %>"
                                                            tabindex="-1" aria-hidden="true">
                                                            <div class="modal-dialog">
                                                                <div class="modal-content">
                                                                    <div class="modal-header">
                                                                        <h5 class="modal-title">
                                                                            <%= name %>
                                                                        </h5>
                                                                        <button type="button"
                                                                            class="btn-close btn-close-white"
                                                                            data-bs-dismiss="modal"
                                                                            aria-label="Close"></button>
                                                                    </div>
                                                                    <div class="modal-body admin__modal-body">
                                                                        <img src="/images/bands/<%= mainImage %>"
                                                                            alt="<%= name %>" class="admin__modal-img">
                                                                        <p class="admin__modal-text">
                                                                            <%= resume %>
                                                                        </p>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <!-- Modal: eliminar banda -->
                                                        <div class="modal fade admin__modal" id="deleteBand<%= id %>"
                                                            tabindex="-1" aria-hidden="true">
                                                            <div class="modal-dialog">
                                                                <div class="modal-content">
                                                                    <div class="modal-header">
                                                                        <h5 class="modal-title">Eliminar banda</h5>
                                                                        <button type="button"
                                                                            class="btn-close btn-close-white"
                                                                            data-bs-dismiss="modal"
                                                                            aria-label="Close"></button>
                                                                    </div>
                                                                    <div class="modal-body">
                                                                        <p>¿Estás seguro que querés eliminar <b>
                                                                                <%= name %>
                                                                            </b>? Esta acción no se puede deshacer.</p>
                                                                    </div>
                                                                    <div class="modal-footer">
                                                                        <button type="button" class="admin__btn-cancel"
                                                                            data-bs-dismiss="modal">Cancelar</button>
                                                                        <form
                                                                            action="/products/bands/remove/<%= id %>?_method=DELETE"
                                                                            method="POST">
                                                                            <button type="submit"
                                                                                class="admin__btn-danger">Eliminar</button>
                                                                        </form>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <% }) %>
                                                </tbody>
                                            </table>
                                        </div>

                                        <div class="admin__pagination" data-pagination-for="bandas">
                                            <button type="button" class="admin__page-btn" data-page-action="prev"
                                                aria-label="Página anterior">
                                                <i class="fa-solid fa-chevron-left"></i>
                                            </button>
                                            <span class="admin__page-info">Página <span data-page-current>1</span> de
                                                <span data-page-total>1</span></span>
                                            <button type="button" class="admin__page-btn" data-page-action="next"
                                                aria-label="Página siguiente">
                                                <i class="fa-solid fa-chevron-right"></i>
                                            </button>
                                        </div>
                                    </section>

                                    <!-- ========== PANEL: ÁLBUMES ========== -->
                                    <section class="admin__panel" id="panel-albumes">
                                        <div class="admin__panel-header">
                                            <div>
                                                <h1 class="admin__title">Álbumes</h1>
                                                <p class="admin__subtitle">
                                                    <%= albums.length %> lanzamientos en el catálogo.
                                                </p>
                                            </div>
                                            <a href="/products/albumAdd" class="admin__btn-add">
                                                <i class="fa-solid fa-plus"></i> Agregar álbum
                                            </a>
                                        </div>

                                        <div class="admin__table-toolbar">
                                            <div class="admin__search-box">
                                                <i class="fa-solid fa-magnifying-glass"></i>
                                                <input type="text" class="admin__search-input" data-search-for="albumes"
                                                    placeholder="Buscar álbum...">
                                            </div>
                                            <span class="admin__search-count" data-search-count-for="albumes">
                                                <%= albums.length %> resultados
                                            </span>
                                        </div>

                                        <div class="admin__table-wrapper" data-table="albumes">
                                            <table class="admin__table">
                                                <thead>
                                                    <tr>
                                                        <th>Álbum</th>
                                                        <th>Género</th>
                                                        <th>Año</th>
                                                        <th>Precio</th>
                                                        <th>Descuento</th>
                                                        <th>Exclusivo</th>
                                                        <th class="admin__col-actions">Acciones</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% albums.forEach(({ id, title, image, genreId, year, price,
                                                        discount, exclusive })=> { %>
                                                        <tr data-search-key="<%= title.toLowerCase() %>">
                                                            <td>
                                                                <div class="admin__row-media">
                                                                    <div class="admin__row-thumb"><img
                                                                            src="/images/albums/<%= image %>"
                                                                            alt="<%= title %>"></div>
                                                                    <span class="admin__row-name">
                                                                        <%= title %>
                                                                    </span>
                                                                </div>
                                                            </td>
                                                            <td><span class="admin__badge">
                                                                    <%= genreLabels[genreId] || genreId %>
                                                                </span></td>
                                                            <td class="admin__col-number">
                                                                <%= year %>
                                                            </td>
                                                            <td class="admin__col-number">$<%= price %>
                                                            </td>
                                                            <td>
                                                                <% if (discount) { %>
                                                                    <span class="admin__badge admin__badge--discount">-
                                                                        <%= discount %>%
                                                                    </span>
                                                                    <% } else { %>
                                                                        <span class="admin__text-muted">—</span>
                                                                        <% } %>
                                                            </td>
                                                            <td>
                                                                <span
                                                                    class="admin__pill <%= exclusive === 0 ? 'admin__pill--off' : 'admin__pill--on' %>">
                                                                    <%= exclusive===0 ? 'No' : 'Sí' %>
                                                                </span>
                                                            </td>
                                                            <td>
                                                                <div class="admin__actions">
                                                                    <button type="button"
                                                                        class="admin__icon-btn admin__icon-btn--view"
                                                                        data-bs-toggle="modal"
                                                                        data-bs-target="#viewAlbum<%= id %>"
                                                                        title="Ver">
                                                                        <i class="fa-solid fa-eye"></i>
                                                                    </button>
                                                                    <button
                                                                        class="admin__icon-btn admin__icon-btn--edit"
                                                                        title="Editar">
                                                                        <a href="/products/edit/album/<%= id %>"
                                                                            class="admin__icon-btn admin__icon-btn--edit"
                                                                            title="Editar">
                                                                            <i class="fa-solid fa-pen"></i>
                                                                        </a>
                                                                    </button>

                                                                    <button type="button"
                                                                        class="admin__icon-btn admin__icon-btn--delete"
                                                                        data-bs-toggle="modal"
                                                                        data-bs-target="#deleteAlbum<%= id %>"
                                                                        title="Eliminar">
                                                                        <i class="fa-solid fa-trash"></i>
                                                                    </button>
                                                                </div>
                                                            </td>
                                                        </tr>

                                                        <!-- Modal: ver álbum -->
                                                        <div class="modal fade admin__modal" id="viewAlbum<%= id %>"
                                                            tabindex="-1" aria-hidden="true">
                                                            <div class="modal-dialog">
                                                                <div class="modal-content">
                                                                    <div class="modal-header">
                                                                        <h5 class="modal-title">
                                                                            <%= title %>
                                                                        </h5>
                                                                        <button type="button"
                                                                            class="btn-close btn-close-white"
                                                                            data-bs-dismiss="modal"
                                                                            aria-label="Close"></button>
                                                                    </div>
                                                                    <div class="modal-body admin__modal-body">
                                                                        <img src="/images/albums/<%= image %>"
                                                                            alt="<%= title %>" class="admin__modal-img">
                                                                        <p class="admin__modal-text">Precio: $<%= price
                                                                                %>
                                                                        </p>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <!-- Modal: eliminar álbum -->
                                                        <div class="modal fade admin__modal" id="deleteAlbum<%= id %>"
                                                            tabindex="-1" aria-hidden="true">
                                                            <div class="modal-dialog">
                                                                <div class="modal-content">
                                                                    <div class="modal-header">
                                                                        <h5 class="modal-title">Eliminar álbum</h5>
                                                                        <button type="button"
                                                                            class="btn-close btn-close-white"
                                                                            data-bs-dismiss="modal"
                                                                            aria-label="Close"></button>
                                                                    </div>
                                                                    <div class="modal-body">
                                                                        <p>¿Estás seguro que querés eliminar <b>
                                                                                <%= title %>
                                                                            </b>? Esta acción no se puede deshacer.</p>
                                                                    </div>
                                                                    <div class="modal-footer">
                                                                        <button type="button" class="admin__btn-cancel"
                                                                            data-bs-dismiss="modal">Cancelar</button>
                                                                        <form
                                                                            action="/products/albums/remove/<%= id %>?_method=DELETE"
                                                                            method="POST">
                                                                            <button type="submit"
                                                                                class="admin__btn-danger">Eliminar</button>
                                                                        </form>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                        <% }) %>
                                                </tbody>
                                            </table>
                                        </div>

                                        <div class="admin__pagination" data-pagination-for="albumes">
                                            <button type="button" class="admin__page-btn" data-page-action="prev"
                                                aria-label="Página anterior">
                                                <i class="fa-solid fa-chevron-left"></i>
                                            </button>
                                            <span class="admin__page-info">Página <span data-page-current>1</span> de
                                                <span data-page-total>1</span></span>
                                            <button type="button" class="admin__page-btn" data-page-action="next"
                                                aria-label="Página siguiente">
                                                <i class="fa-solid fa-chevron-right"></i>
                                            </button>
                                        </div>
                                    </section>

                                    <!-- ========== PANEL: MERCHANDISING ========== -->
                                    <section class="admin__panel" id="panel-merch">
                                        <div class="admin__panel-header">
                                            <div>
                                                <h1 class="admin__title">Merchandising</h1>
                                                <p class="admin__subtitle">
                                                    <%= merchs.length %> productos en el catálogo.
                                                </p>
                                            </div>
                                            <a href="/products/mercheAdd" class="admin__btn-add">
                                                <i class="fa-solid fa-plus"></i> Agregar producto
                                            </a>
                                        </div>

                                        <div class="admin__table-toolbar">
                                            <div class="admin__search-box">
                                                <i class="fa-solid fa-magnifying-glass"></i>
                                                <input type="text" class="admin__search-input" data-search-for="merch"
                                                    placeholder="Buscar producto...">
                                            </div>
                                            <span class="admin__search-count" data-search-count-for="merch">
                                                <%= merchs.length %> resultados
                                            </span>
                                        </div>

                                        <div class="admin__table-wrapper" data-table="merch">
                                            <table class="admin__table">
                                                <thead>
                                                    <tr>
                                                        <th>Producto</th>
                                                        <th>Tipo</th>
                                                        <th>Precio</th>
                                                        <th>Descuento</th>
                                                        <th>Exclusivo</th>
                                                        <th class="admin__col-actions">Acciones</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% merchs.forEach(({ id, name, image, price, discount, exclusive,
                                                        typeId })=> { %>
                                                        <tr data-search-key="<%= name.toLowerCase() %>">
                                                            <td>
                                                                <div class="admin__row-media admin__row-media--light">
                                                                    <div
                                                                        class="admin__row-thumb admin__row-thumb--light">
                                                                        <img src="/images/merch/<%= image %>"
                                                                            alt="<%= name %>">
                                                                    </div>
                                                                    <span class="admin__row-name">
                                                                        <%= name %>
                                                                    </span>
                                                                </div>
                                                            </td>
                                                            <td><span class="admin__badge">
                                                                    <%= typeLabels[typeId] || typeId %>
                                                                </span></td>
                                                            <td class="admin__col-number">$<%= price %>
                                                            </td>
                                                            <td>
                                                                <% if (discount) { %>
                                                                    <span class="admin__badge admin__badge--discount">-
                                                                        <%= discount %>%
                                                                    </span>
                                                                    <% } else { %>
                                                                        <span class="admin__text-muted">—</span>
                                                                        <% } %>
                                                            </td>
                                                            <td>
                                                                <span
                                                                    class="admin__pill <%= exclusive === 0 ? 'admin__pill--off' : 'admin__pill--on' %>">
                                                                    <%= exclusive===0 ? 'No' : 'Sí' %>
                                                                </span>
                                                            </td>
                                                            <td>
                                                                <div class="admin__actions">
                                                                    <button type="button"
                                                                        class="admin__icon-btn admin__icon-btn--view"
                                                                        data-bs-toggle="modal"
                                                                        data-bs-target="#viewMerch<%= id %>"
                                                                        title="Ver">
                                                                        <i class="fa-solid fa-eye"></i>
                                                                    </button>
                                                                    <button
                                                                        class="admin__icon-btn admin__icon-btn--edit"
                                                                        title="Editar">
                                                                        <a href="/products/edit/merch/<%= id %>"
                                                                            class="admin__icon-btn admin__icon-btn--edit"
                                                                            title="Editar">
                                                                            <i class="fa-solid fa-pen"></i>
                                                                        </a>
                                                                    </button>

                                                                    <button type="button"
                                                                        class="admin__icon-btn admin__icon-btn--delete"
                                                                        data-bs-toggle="modal"
                                                                        data-bs-target="#deleteMerch<%= id %>"
                                                                        title="Eliminar">
                                                                        <i class="fa-solid fa-trash"></i>
                                                                    </button>
                                                                </div>
                                                            </td>
                                                        </tr>

                                                        <!-- Modal: ver producto -->
                                                        <div class="modal fade admin__modal" id="viewMerch<%= id %>"
                                                            tabindex="-1" aria-hidden="true">
                                                            <div class="modal-dialog">
                                                                <div class="modal-content">
                                                                    <div class="modal-header">
                                                                        <h5 class="modal-title">
                                                                            <%= name %>
                                                                        </h5>
                                                                        <button type="button"
                                                                            class="btn-close btn-close-white"
                                                                            data-bs-dismiss="modal"
                                                                            aria-label="Close"></button>
                                                                    </div>
                                                                    <div class="modal-body admin__modal-body">
                                                                        <img src="/images/merch/<%= image %>"
                                                                            alt="<%= name %>"
                                                                            class="admin__modal-img admin__modal-img--light">
                                                                        <p class="admin__modal-text">Precio: $<%= price
                                                                                %>
                                                                        </p>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>

                                                        <!-- Modal: eliminar producto -->
                                                        <div class="modal fade admin__modal" id="deleteMerch<%= id %>"
                                                            tabindex="-1" aria-hidden="true">
                                                            <div class="modal-dialog">
                                                                <div class="modal-content">
                                                                    <div class="modal-header">
                                                                        <h5 class="modal-title">Eliminar producto</h5>
                                                                        <button type="button"
                                                                            class="btn-close btn-close-white"
                                                                            data-bs-dismiss="modal"
                                                                            aria-label="Close"></button>
                                                                    </div>
                                                                    <div class="modal-body">
                                                                        <p>¿Estás seguro que querés eliminar <b>
                                                                                <%= name %>

                        <%- include('../partials/footer') %>

                            <script>
                                const adminNavLinks = document.querySelectorAll('.admin__nav-link');
                                const adminPanels = document.querySelectorAll('.admin__panel');

                                adminNavLinks.forEach(link => {
                                    link.addEventListener('click', () => {
                                        const target = link.dataset.panel;

                                        adminNavLinks.forEach(l => l.classList.remove('is-active'));
                                        adminPanels.forEach(p => p.classList.remove('is-active'));

                                        link.classList.add('is-active');
                                        document.getElementById('panel-' + target).classList.add('is-active');
                                    });
                                });

                                function initAdminTable(key, pageSize) {
                                    const wrapper = document.querySelector('[data-table="' + key + '"]');
                                    const pagination = document.querySelector('[data-pagination-for="' + key + '"]');
                                    const searchInput = document.querySelector('[data-search-for="' + key + '"]');
                                    const countLabel = document.querySelector('[data-search-count-for="' + key + '"]');

                                    if (!wrapper || !pagination) return;

                                    const allRows = Array.from(wrapper.querySelectorAll('tbody > tr'));
                                    const prevBtn = pagination.querySelector('[data-page-action="prev"]');
                                    const nextBtn = pagination.querySelector('[data-page-action="next"]');
                                    const currentLabel = pagination.querySelector('[data-page-current]');
                                    const totalLabel = pagination.querySelector('[data-page-total]');

                                    let filteredRows = allRows;
                                    let currentPage = 1;

                                    function render() {
                                        const totalPages = Math.max(1, Math.ceil(filteredRows.length / pageSize));
                                        if (currentPage > totalPages) currentPage = totalPages;

                                        allRows.forEach(row => { row.style.display = 'none'; });

                                        const start = (currentPage - 1) * pageSize;
                                        filteredRows.slice(start, start + pageSize).forEach(row => { row.style.display = ''; });

                                        currentLabel.textContent = currentPage;
                                        totalLabel.textContent = totalPages;
                                        prevBtn.disabled = currentPage === 1;
                                        nextBtn.disabled = currentPage === totalPages;
                                        pagination.style.display = totalPages <= 1 ? 'none' : 'flex';

                                        if (countLabel) {
                                            countLabel.textContent = filteredRows.length + (filteredRows.length === 1 ? ' resultado' : ' resultados');
                                        }
                                    }

                                    function applyFilter(term) {
                                        const normalized = term.trim().toLowerCase();
                                        filteredRows = normalized
                                            ? allRows.filter(row => (row.dataset.searchKey || '').includes(normalized))
                                            : allRows;
                                        currentPage = 1;
                                        render();
                                    }

                                    if (searchInput) {
                                        searchInput.addEventListener('input', (e) => applyFilter(e.target.value));
                                    }

                                    prevBtn.addEventListener('click', () => {
                                        if (currentPage > 1) {
                                            currentPage--;
                                            render();
                                        }
                                    });

                                    nextBtn.addEventListener('click', () => {
                                        const totalPages = Math.max(1, Math.ceil(filteredRows.length / pageSize));
                                        if (currentPage < totalPages) {
                                            currentPage++;
                                            render();
                                        }
                                    });

                                    render();
                                }

                                initAdminTable('bandas', 10);
                                initAdminTable('albumes', 10);
                                initAdminTable('merch', 10);
                            </script>
            </body>

            </html>
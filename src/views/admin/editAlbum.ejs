<!DOCTYPE html>
<html>

<%- include('../partials/head',{ title : 'ADMIN' }) %>

    <body>
        <%- include('../partials/header') %>

           <main class="add-form__page-wrapper">

    <div class="add-form__container">

        <!-- BACK -->

        <nav class="add-form__back-nav">
            <a href="/users/admin" class="back-nav__link">
                <i class="fa-solid fa-arrow-left"></i>
                Volver al panel de administración
            </a>
        </nav>

        <!-- HEADER -->

        <div class="add-form__header">

            <div class="add-form__header-icon">
                <i class="fa-solid fa-compact-disc"></i>
            </div>

            <div class="add-form__header-content">

                <span class="add-form__eyebrow">
                    ADMINISTRACIÓN
                </span>

                <h1 class="add-form__title">
                    Editar Álbum
                </h1>

                <p class="add-form__subtitle">
                    Estás editando:
                    <strong><%= album.title %></strong>
                </p>

            </div>

        </div>

        <form
            id="editAlbumForm"
            class="add-form__card"
            action="/products/edit/album/<%= album.id %>?_method=PUT"
            method="POST"
            enctype="multipart/form-data">

            <!-- IDENTIDAD -->

            <section class="add-form__section">

                <h2 class="add-form__section-title">
                    <span class="add-form__section-num">01</span>
                    Identidad
                </h2>

                <div class="add-form__grid">

                    <div class="add-form__field add-form__field--wide">

                        <label class="add-form__label" for="title">
                            Título del Álbum
                        </label>

                        <input
                            type="text"
                            id="title"
                            name="title"
                            class="add-form__input <%= locals.errors && (errors.title && 'is-invalid') %>"
                            value="<%= album.title %>">

                        <small class="add-form__error">
                            <%= locals.errors && (errors.title && errors.title.msg) %>
                        </small>

                    </div>

                    <div class="add-form__field">

                        <label class="add-form__label" for="discography">
                            Discográfica
                        </label>

                        <input
                            type="text"
                            id="discography"
                            name="discography"
                            class="add-form__input <%= locals.errors && (errors.discography && 'is-invalid') %>"
                            value="<%= album.discography %>">

                        <small class="add-form__error">
                            <%= locals.errors && (errors.discography && errors.discography.msg) %>
                        </small>

                    </div>

                    <div class="add-form__field">

                        <label class="add-form__label" for="year">
                            Año de publicación
                        </label>

                        <input
                            type="number"
                            id="year"
                            name="year"
                            class="add-form__input <%= locals.errors && (errors.year && 'is-invalid') %>"
                            value="<%= album.year %>">

                        <small class="add-form__error">
                            <%= locals.errors && (errors.year && errors.year.msg) %>
                        </small>

                    </div>

                </div>

            </section>

            <!-- CATEGORIZACIÓN -->

            <section class="add-form__section">

                <h2 class="add-form__section-title">
                    <span class="add-form__section-num">02</span>
                    Clasificación
                </h2>

                <div class="add-form__grid">

                    <div class="add-form__field">

                        <label class="add-form__label" for="bandId">
                            Banda
                        </label>

                        <select
                            id="bandId"
                            name="bandId"
                            class="add-form__input add-form__select">

                            <% bands.forEach(band => { %>

                                <option
                                    <%= band.id === album.bandId ? 'selected' : '' %>
                                    value="<%= band.id %>">

                                    <%= band.name %>

                                </option>

                            <% }) %>

                        </select>

                    </div>

                    <div class="add-form__field">

                        <label class="add-form__label" for="genreId">
                            Género
                        </label>

                        <select
                            id="genreId"
                            name="genreId"
                            class="add-form__input add-form__select">

                            <% genres.forEach(genre => { %>

                                <option
                                    <%= genre.id === album.genreId ? 'selected' : '' %>
                                    value="<%= genre.id %>">

                                    <%= genre.name %>

                                </option>

                            <% }) %>

                        </select>

                    </div>

                </div>

            </section>

            <!-- VENTA -->

            <section class="add-form__section">

                <h2 class="add-form__section-title">
                    <span class="add-form__section-num">03</span>
                    Venta
                </h2>

                <div class="add-form__grid">

                    <div class="add-form__field">

                        <label class="add-form__label" for="price">
                            Precio
                        </label>

                        <input
                            type="number"
                            step="0.01"
                            id="price"
                            name="price"
                            class="add-form__input <%= locals.errors && (errors.price && 'is-invalid') %>"
                            value="<%= album.price %>">

                        <small class="add-form__error">
                            <%= locals.errors && (errors.price && errors.price.msg) %>
                        </small>

                    </div>

                    <div class="add-form__field">

                        <label class="add-form__label" for="discount">
                            Descuento (%)
                        </label>

                        <input
                            type="number"
                            step="0.01"
                            id="discount"
                            name="discount"
                            class="add-form__input <%= locals.errors && (errors.discount && 'is-invalid') %>"
                            value="<%= album.discount ? album.discount : 0 %>">

                        <small class="add-form__error">
                            <%= locals.errors && (errors.discount && errors.discount.msg) %>
                        </small>

                    </div>

                    <div class="add-form__field add-form__field--checkbox-row add-form__field--wide">

                        <label class="add-form__checkbox-label">

                            <input
                                type="checkbox"
                                id="exclusive"
                                name="exclusive"
                                class="add-form__checkbox"
                                <%= album.exclusive === 1 ? 'checked' : '' %>>

                            <span class="add-form__checkbox-text">
                                Álbum exclusivo
                            </span>

                        </label>

                    </div>

                </div>

            </section>

            <!-- DESCRIPCIÓN -->

            <section class="add-form__section">

                <h2 class="add-form__section-title">
                    <span class="add-form__section-num">04</span>
                    Descripción
                </h2>

                <div class="add-form__field">

                    <label class="add-form__label" for="description">
                        Descripción
                    </label>

                    <textarea
                        id="description"
                        name="description"
                        class="add-form__input add-form__textarea <%= locals.errors && (errors.description && 'is-invalid') %>"><%= album.description %></textarea>

                    <small class="add-form__error">
                        <%= locals.errors && (errors.description && errors.description.msg) %>
                    </small>

                </div>

            </section>

            <!-- IMAGEN -->

            <section class="add-form__section">

                <h2 class="add-form__section-title">
                    <span class="add-form__section-num">05</span>
                    Imagen
                </h2>

                <div class="add-form__field">

                    <label class="add-form__label">
                        Portada actual
                    </label>

                    <img
                        src="/images/albums/<%= album.image %>"
                        alt="<%= album.title %>"
                        class="admin-preview-image">

                    <label for="image" class="add-form__file-btn">
                        <i class="fa-solid fa-image"></i>
                        Cambiar portada
                    </label>

                    <input
                        hidden
                        type="file"
                        id="image"
                        name="image">

                    <small class="add-form__error">
                        <%= locals.errors && (errors.image && errors.image.msg) %>
                    </small>

                </div>

            </section>

            <!-- ACCIONES -->

            <div class="add-form__actions">

                <a href="/users/admin" class="add-form__btn-cancel">
                    Cancelar
                </a>

                <button
                    type="submit"
                    class="add-form__btn-submit"
                    id="enviarForm">

                    <i class="fa-solid fa-floppy-disk"></i>
                    Actualizar álbum

                </button>

            </div>

        </form>

    </div>

</main>

<script src="/javascripts/editAlbumFrontendValidations.js"></script>
            <%- include('../partials/footer') %>

    </body>

</html>
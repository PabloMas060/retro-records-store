<!DOCTYPE html>
<html lang="es">
<%- include('partials/head', { title: 'Detalle de Artista' }) %>

<body class="products__body">
    <%- include('partials/header') %>

    <div class="artist-detail__page-wrapper">

        <header class="artist-detail__hero" style="background-image: linear-gradient(to bottom, rgba(7, 8, 10, 0.3) 20%, #07080a 100%), url('/images/bands/<%= band.image %>');">
            <div class="artist-detail__hero-container">
                <span class="artist-detail__badge-genre">Esto es...</span>
                <h1 class="artist-detail__main-title"><%= band.name %></h1>
                <% if (band.phrase) { %>
                    <p class="artist-detail__quote">"<%= band.phrase %>"</p>
                <% } %>
                
                <div class="artist-detail__meta-grid">
                    <div class="meta__badge">
                        <i class="fa-solid fa-calendar-days"></i> 
                        <span><%= band.dateFounded %> - <%= band.dateEnded ? band.dateEnded : 'Banda Vigente' %></span>
                    </div>
                    <div class="meta__badge">
                        <i class="fa-solid fa-guitar"></i> 
                        <span><%= band.totalShows %> Conciertos</span>
                    </div>
                    <div class="meta__badge">
                        <i class="fa-solid fa-clock"></i> 
                        <span>Próximo: <%= band.nextShows %></span>
                    </div>
                </div>
            </div>
        </header>

        <main class="artist-detail__content container">
            
            <section class="artist-detail__bio-box">
                <h2 class="section__premium-title">Historia de la banda</h2>
                <p class="artist-detail__bio-text"><%= band.history %></p>
            </section>

            <section class="artist-detail__section">
                <h2 class="section__premium-title">Álbumes y Vinilos Disponibles</h2>
                <p class="section__premium-subtitle">Legado Discográfico</p>

                <div class="products__premium-grid">
                    <% albums.forEach(({ id, title, image, year }) => { %>
                        <article class="product__premium-card" id="album<%= id %>">
                            <div class="product__card-media">
                                <img src="/images/albums/<%= image %>" alt="<%= title %>" class="product__card-img">
                                <div class="product__card-overlay">
                                    <a href="/products/albums/detail/<%= id %>" class="product__card-btn">
                                        <i class="fa-solid fa-compact-disc"></i> Ver Vinilo
                                    </a>
                                </div>
                            </div>
                            <div class="product__card-info">
                                <h4 class="product__card-title"><%= title %></h4>
                                <span class="product__card-meta"><%= year %></span>
                            </div>
                        </article>
                    <% }) %>
                </div>
            </section>

            <section class="artist-detail__section">
                <h2 class="section__premium-title">Merch Oficial</h2>
                <p class="section__premium-subtitle">Indumentaria y Accesorios Exclusivos</p>

                <div class="products__premium-grid">
                    <% merchs.forEach(({ id, price, image }) => { %>
                        <article class="product__premium-card">
                            <div class="product__card-media merch-bg">
                                <img src="/images/merch/<%= image %>" alt="Merch" class="product__card-img contain-img">
                                <div class="product__card-overlay">
                                    <a href="/products/merchs/detail/<%= id %>" class="product__card-btn">
                                        <i class="fa-solid fa-shirt"></i> Ver Detalle
                                    </a>
                                </div>
                            </div>
                            <div class="product__card-info">
                                <% types.forEach(type => { %>
                                    <% if (id === type.id) { %>
                                        <h4 class="product__card-title"><%= type.name %></h4>
                                    <% } %>
                                <% }) %> <span class="product__card-price">$<%= price %></span>
                            </div>
                        </article>
                    <% }) %>
                </div>
            </section>

        </main>
    </div> <%- include('partials/footer') %>
</body>
</html>